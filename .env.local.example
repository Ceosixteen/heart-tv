# ─── YouTube Live Detection ────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Enable: YouTube Data API v3
# Quota cost: 100 units per live check; free tier = 10,000 units/day
# Server caches for 5 min, so real usage ≈ 12 API calls/hour max
YOUTUBE_API_KEY=

# Your channel ID — found at: youtube.com/channel/UC... (in the URL)
# or: YouTube Studio → Settings → Channel → Advanced → Channel ID
YOUTUBE_CHANNEL_ID=

# ─── Facebook Live Detection ───────────────────────────────────
# Create a Facebook App at developers.facebook.com
# Add "pages_read_engagement" permission
# Generate a long-lived Page Access Token (60-day, or via System User for permanent)
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# ─── Firestore (partner submissions) ──────────────────────────
# Create a Firebase project at console.firebase.google.com
# Enable Firestore in Native mode
# Project Settings → Service Accounts → Generate new private key
# Copy the values from the downloaded JSON file here.
# On Vercel, paste the private key exactly as-is — Vercel handles the newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── General ───────────────────────────────────────────────────
# Used only for absolute URLs in metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://hearttv.org
